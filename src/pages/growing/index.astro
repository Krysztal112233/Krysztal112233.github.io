---
import { getCollection } from "astro:content";
import Article from "../../components/Article.astro";
import PlantIndexItem from "../../components/PlantIndexItem.astro";
import MainFrame from "../../layout/MainFrame.astro";
import { groupPlants } from "../../utils/growingLog";

const entries = await getCollection("growing");
const plants = groupPlants(entries);
---

<MainFrame subtitle="种植日志">
    <Article>
        <div class="pt-1 pb-1">
            {
                plants.map((plant, index) => (
                    <>
                        <PlantIndexItem plant={plant} />
                        {index < plants.length - 1 && (
                            <div class="px-8 py-1">
                                <div class="flex items-center gap-3 opacity-20">
                                    <div
                                        class="bg-base-300 h-px flex-1"
                                        style="background-image: radial-gradient(circle, currentColor 1px, transparent 1.2px); background-position: center; background-repeat: repeat-x; background-size: 8px 1px;"
                                    />
                                </div>
                            </div>
                        )}
                    </>
                ))
            }
            {
                plants.length === 0 && (
                    <div class="p-8 text-center text-gray-500">
                        还没有任何种植记录。
                    </div>
                )
            }
        </div>
    </Article>
</MainFrame>
